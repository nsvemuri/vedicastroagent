# Pick one provider (gemini or claude). Optional if only one key is set.
# LLM_PROVIDER=gemini
# LLM_PROVIDER=claude

# --- Gemini (only needed when using --provider gemini / LLM_PROVIDER=gemini) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini model override (default: gemini-3.1-pro-preview)
GEMINI_MODEL=gemini-3.1-pro-preview
# GOOGLE_API_KEY=...   # also accepted by the Google GenAI SDK

# --- Claude / Anthropic (only needed when using --provider claude) ---
# Get a key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_API_KEY=...   # alternate env name also accepted
# Claude aliases: sonnet | opus | mythos  (or a full id like claude-sonnet-5)
# CLAUDE_MODEL=sonnet

# Sampling: parse=0, predict=0.05 for Gemini.
# Claude Sonnet 5 / Opus / Mythos: temperature is omitted (API rejects the parameter).
# Claude defaults: parse max_tokens=8192 / effort=low; predict=20480 / effort=medium.
# Spiritual uses 24576; longevity uses 32768 (full JH dump + 45-year gochara). Env raises all topics.
# System prompts are prompt-cached (ephemeral) across topic calls.
# CLAUDE_PARSE_MAX_TOKENS=8192
# CLAUDE_PREDICTION_MAX_TOKENS=20480
# CLAUDE_PARSE_EFFORT=low
# CLAUDE_PREDICTION_EFFORT=medium
# GEMINI_PREDICTION_MAX_TOKENS=20480
# Claude requests use streaming (required by the SDK for long/high-max_tokens calls).

# Parallel topic LLM calls (default 7). Set to 1 for sequential.
# VEDIC_MAX_WORKERS=7
