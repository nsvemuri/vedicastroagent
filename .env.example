# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional overrides
# Default: Gemini 3.1 Pro
GEMINI_MODEL=gemini-3.1-pro-preview
# GOOGLE_API_KEY=...   # also accepted by the Google GenAI SDK

# Sampling temperature is fixed at 0 in code (GeminiConfig.temperature)
# for factual chart/dasa parsing. Do not raise it without an explicit product decision.

# Parallel topic Gemini calls (default 7). Set to 1 for sequential.
# VEDIC_MAX_WORKERS=7
