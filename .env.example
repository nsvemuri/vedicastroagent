# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional overrides
# Default: Gemini 3.1 Pro
GEMINI_MODEL=gemini-3.1-pro-preview
# GOOGLE_API_KEY=...   # also accepted by the Google GenAI SDK

# Sampling: parse=0 (GeminiConfig.parse_temperature), predict=0.05 (prediction_temperature)
# Prediction max_output_tokens raised to 16384 to reduce truncation on long reports.

# Parallel topic Gemini calls (default 7). Set to 1 for sequential.
# VEDIC_MAX_WORKERS=7
